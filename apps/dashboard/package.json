{
  "name": "dbdeck-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --prepare && vite --host 127.0.0.1 --port 8080",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "connector": "node connector/server.mjs",
    "pretest": "node scripts/build.mjs --prepare",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "tsc --noEmit",
    "lint": "prettier --check src connector scripts test package.json tsconfig.json vite.config.ts index.html wrangler.jsonc",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.149.0"
  }
}
