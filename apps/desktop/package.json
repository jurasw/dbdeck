{
  "name": "dbdeck-desktop",
  "productName": "DBDeck Demo",
  "version": "0.4.3-demo.1",
  "private": true,
  "description": "DBDeck macOS desktop demo, built from the extension's drivers and panels.",
  "author": "DBDeck",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && npm --prefix ../extension run build && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit",
    "lint": "prettier --check src scripts test package.json tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "validate": "npm run check && npm run lint && npm test && npm run build",
    "package": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "package:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.58.0",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "dev.dbdeck.desktop.demo",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "DBDeck-demo-${arch}.dmg",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "notarize": false,
      "minimumSystemVersion": "12.0",
      "icon": "dist/icon.icns"
    },
    "dmg": {
      "title": "DBDeck Demo",
      "icon": "dist/icon.icns",
      "sign": false
    }
  }
}
